# ── Coffer environment ─────────────────────────────────────────────
# Copy to .env (api reads apps/api/.env or repo root via dotenv).

# Database. Dev default is SQLite (zero setup). For Postgres, change
# provider in apps/api/prisma/schema.prisma to "postgresql" and set:
# DATABASE_URL="postgresql://user:pass@localhost:5432/coffer"
DATABASE_URL="file:./dev.db"

# Optional Redis. Absent → in-memory TTL cache (fine for dev).
# REDIS_URL="redis://localhost:6379"

# Privy (https://dashboard.privy.io → create app → App ID).
# Absent → web runs in demo-auth mode with a fake local user.
# VITE_PRIVY_APP_ID="clxxxxxxxxxxxxx"
# PRIVY_APP_SECRET="..."

# Price data. Jupiter Price v3 works keyless at low rate; add a key
# from portal.jup.ag for real rate limits. Birdeye optional.
# JUPITER_API_KEY="..."
# BIRDEYE_API_KEY="..."

# Solana RPC (devnet default). Helius recommended.
SOLANA_RPC_URL="https://api.devnet.solana.com"

# Mainnet execution gate — the ibkr convention. Never set casually.
# I_UNDERSTAND_LIVE_TRADING_RISKS="yes"
